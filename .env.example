# ==================== 基础运行 ====================
APP_NAME=圈析智图
HOST=127.0.0.1
PORT=8015
REQUEST_TIMEOUT_SECONDS=20

# ==================== 百度地图 Web 服务 API ====================
# 在百度地图开放平台创建“服务端”类型 AK 后填写。
# 真实模式至少需要 BAIDU_MAP_AK；AK 只由后端读取，不会返回前端。
BAIDU_MAP_AK=
# 可选但强烈推荐：百度地图 JSAPI GL 浏览器端 AK，用于真正的 WebGL 3D 城市地图。
# 浏览器端 AK 会在页面加载地图时公开，这是 JSAPI 的正常机制；请单独创建浏览器类型 AK，配置 Referer 白名单，切勿复用服务端 AK。
BAIDU_MAP_BROWSER_AK=
# 可选：百度地图开放平台“个性化地图”样式 ID；配置后真实城市 3D 视图使用比赛展示风格。
BAIDU_MAP_STYLE_ID=
BAIDU_API_BASE=https://api.map.baidu.com
# 免费额度建议设为 1，避免贴近低并发上限；确认账户权益后再谨慎提高。
BAIDU_CONCURRENCY=1
BAIDU_RETRY_TIMES=2
# 跨任务本地 SQLite 缓存，减少重复 QPS/配额消耗。
BAIDU_CACHE_TTL_SECONDS=900
# Place API 每个设施类别最多翻页数；每页最多 20 条。
BAIDU_POI_MAX_PAGES=3

# ==================== 分析参数（网页可覆盖一部分） ====================
DEFAULT_THRESHOLD_MINUTES=15
DEFAULT_SAMPLE_BEARINGS=16
DEFAULT_POI_RADIUS_METERS=1800
MAX_SAMPLE_BEARINGS=32
MAX_POI_RADIUS_METERS=3000
MAX_ANALYSIS_SECONDS=120
# 仅用于“直线圆 vs 真实路网”方法对比，不作为官方评价标准。
BASELINE_WALK_SPEED_MPS=1.2

# ==================== 可选模型 ====================
# 核心地理计算、资格判断与盲区诊断完全不依赖大模型。
# 当前版本预留兼容字段，后续如需“自然语言规划说明”可接 OpenAI Compatible API。
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
